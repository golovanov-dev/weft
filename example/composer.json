{
  "name": "golovanov/weft-docs",
  "description": "The Weft documentation site — a working example of a site built with the Weft engine.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "golovanov/weft": "^0.2",
    "league/commonmark": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "health": "weft-health",
    "sitemap": "php scripts/sitemap.php",
    "cache-clear": "php scripts/cache-clear.php"
  }
}
