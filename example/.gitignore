# Ignores for anyone who copies this directory as the starting point for their own site.

/vendor/
/node_modules/

# Dependency lock file.
#
# In THIS demo it is intentionally NOT committed: the example resolves the engine from Packagist,
# so pinning it here would freeze the very version we want to exercise.
#
# For YOUR site, delete the next line and commit composer.lock — a deployed application should
# install the exact versions it was tested with.
/composer.lock

/config/config.php
/storage/logs/*
/storage/cache/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
/storage/indexnow.json

# Build output.
#
# For YOUR site, uncomment the next line and build in CI or on deploy — committing hashed build
# artefacts just adds churn.
#
#   /public/dist/
#
# In THIS demo it is intentionally committed (see the note in the repo-root .gitignore) so the
# example runs straight after `composer install`, without installing Node.

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
