RewriteEngine On

# 1) Force HTTPS (comment out for local http dev).
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Drop the www. prefix.
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 3) Serve existing files/directories as-is (built assets, images, robots.txt, ...).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4) Everything else goes to the front controller.
RewriteRule ^ index.php [L,QSA]

# Basic hardening.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Do not serve dotfiles.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
